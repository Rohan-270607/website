# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# On Vercel, set the same names under Project Settings -> Environment Variables.
# ALL of these are SERVER-SIDE ONLY. Do not give any of them a VITE_/NEXT_PUBLIC_ prefix.

# --- Supabase (Project Settings -> API) ---------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service-role key BYPASSES Row Level Security. Server-side only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Privacy ------------------------------------------------------------------
# Secret salt for hashing IPs / user agents. 16+ random chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later is harmless: it just resets rate-limit counters and unique-visitor continuity.
IP_HASH_SALT=

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of exact frontend origins (scheme + host + port, no trailing slash).
# Requests from any other browser origin are refused with 403.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.example

# --- Email notifications (optional) -------------------------------------------
# Leave RESEND_API_KEY empty to disable. Both RESEND_API_KEY and NOTIFY_TO_EMAIL are needed.
RESEND_API_KEY=
# Where notifications are sent (your inbox).
NOTIFY_TO_EMAIL=
# Optional sender. Default "Portfolio <onboarding@resend.dev>" only delivers to the email
# address of your own Resend account, which is fine for notifying yourself. To use your own
# domain, verify it in Resend first.
NOTIFY_FROM_EMAIL=

# --- Only used by `npm run types` (not read by the API) -----------------------
SUPABASE_PROJECT_REF=
